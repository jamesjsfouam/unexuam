rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Project: unexuam-campus-ni (Standard edition, (default) database)
    // Auth Note (REM-08):
    //   - /usuarios, /mensajes, and /reportes_bloqueo require a non-anonymous
    //     Firebase Auth session. Student identity is matched ONLY against
    //     request.auth.uid == cif or the custom claim request.auth.token.cif == cif.
    //     The claim is set server-side by the blocking function
    //     functions/index.js:asignarCifAlCrearCuenta, which also refuses to create
    //     an account for a CIF that is already taken (Firestore /usuarios or
    //     /cuentas_web). The e-mail address is NOT trusted (it is unverified).
    //   - Administrators are verified via custom claim admin == true or
    //     /admins/{request.auth.uid}.
    //   - /campus/estado allows unauthenticated public read (required by
    //     MeshForegroundService via public REST) and restricts writes to
    //     authenticated Firebase Auth administrators (isAdminAuth()).
    //
    // Collection: usuarios
    // Document ID: {cif} matching ^[0-9A-Z-]{4,15}$, != 'ADMIN', != 'TODOS'
    // Access: Read/create/update restricted to the authenticated owner (cif)
    //         or isAdminAuth(); prevents public exposure of sal and hash.
    // Fields:
    //   - cif: string (required, immutable, == document ID)
    //   - nombre: string (required, immutable, 2..40 chars)
    //   - sal: string (required, immutable, 8..64 chars)
    //   - hash: string (required, immutable, 20..160 chars)
    //   - telefono: string (required, immutable, 3..40 chars)
    //   - lugar: string (required, mutable, 1..60 chars)
    //   - admin: bool (required, immutable, must be false on create)
    //   - creado: number (required, immutable)
    //   - ultimoAcceso: number (optional, mutable)
    //
    // Collection: mensajes
    // Document ID: {msgId}
    // Access: Authenticated read only for participants (de/para), broadcast
    //         messages (para == 'TODOS'), or isAdminAuth(). Authenticated
    //         create/update only for authorized sender/participants or admins.
    // Fields:
    //   - de: string (required, immutable, 2..15 chars)
    //   - deNombre: string (required, immutable, 1..40 chars)
    //   - para: string (required, immutable, 2..15 chars)
    //   - texto: string (required, immutable, 1..500 chars)
    //   - hora: string (required, immutable, 1..20 chars)
    //   - ts: number (required, immutable)
    //   - estado: string (required, 'entregado' | 'en cola'; update only 'en cola' -> 'entregado')
    //
    // Collection: campus
    // Document ID: 'estado' only
    // Access: Public read on /campus/estado; create/update restricted to
    //         Firebase Auth admins (isAdminAuth()).
    // Fields:
    //   - bloqueados: list (required, max 100 items)
    //   - congestion: map (required, max 100 entries)
    //   - actualizado: number (required)
    //   - emergencia: map | null (optional, keys <= 5: id, tipo, titulo, texto, hora; each string <= 250 chars)
    //
    // Collection: admins
    // Document ID: {uid} (Firebase Auth UID)
    // Access: Self-read only (request.auth.uid == uid); writes denied to clients
    //         (managed exclusively via Firebase Console or Admin SDK).
    //
    // Collection: reportes_bloqueo
    // Document ID: {repId}
    // Access: Authenticated read and create; updates (resolve/approve/discard)
    //         restricted strictly to isAdminAuth().
    // Fields:
    //   - origen: string (required, immutable, 1..60 chars)
    //   - destino: string (required, immutable, 1..60 chars)
    //   - autor: string (required, immutable, 2..15 chars)
    //   - ts: number (required, immutable)
    //   - estado: string (optional on create ['pendiente'], mutable by admin, 1..30 chars)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null &&
             (!('firebase' in request.auth.token) ||
              !('sign_in_provider' in request.auth.token.firebase) ||
              request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    function isSelfUser(cif) {
      return isAuthenticated() &&
             cif is string &&
             (request.auth.uid == cif ||
              ('cif' in request.auth.token && request.auth.token.cif == cif));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
             request.resource.data[field].size() >= minLen &&
             request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
             (request.resource.data[field] is string &&
              request.resource.data[field].size() >= minLen &&
              request.resource.data[field].size() <= maxLen);
    }

    function isValidOptionalNumber(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] is number;
    }

    function isValidList(listData, maxSize) {
      return listData is list && listData.size() <= maxSize;
    }

    function isValidMap(mapData, maxSize) {
      return mapData is map && mapData.size() <= maxSize;
    }

    function isValidMapStringField(mapData, key, maxLen) {
      return !(key in mapData) ||
             (mapData[key] is string && mapData[key].size() <= maxLen);
    }

    function isValidEmergencia(data) {
      return !('emergencia' in data) ||
             data.emergencia == null ||
             (data.emergencia is map &&
              data.emergencia.size() <= 5 &&
              data.emergencia.keys().hasOnly(['id', 'tipo', 'titulo', 'texto', 'hora']) &&
              isValidMapStringField(data.emergencia, 'id', 250) &&
              isValidMapStringField(data.emergencia, 'tipo', 250) &&
              isValidMapStringField(data.emergencia, 'titulo', 250) &&
              isValidMapStringField(data.emergencia, 'texto', 250) &&
              isValidMapStringField(data.emergencia, 'hora', 250));
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidCifId(cif) {
      return cif is string &&
             cif.matches('^[0-9A-Z-]{4,15}$') &&
             cif != 'ADMIN' &&
             cif != 'TODOS';
    }

    function isAdminAuth() {
      return isAuthenticated() &&
             (('admin' in request.auth.token && request.auth.token.admin == true) ||
              exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // ===============================================================
    // Domain Validators (Used in both create and update)
    // ===============================================================

    function isValidUsuario(data, cif) {
      return hasRequiredFields(['cif', 'nombre', 'sal', 'hash', 'telefono', 'lugar', 'admin', 'creado']) &&
             hasOnlyAllowedFields(['cif', 'nombre', 'sal', 'hash', 'telefono', 'lugar', 'admin', 'creado', 'ultimoAcceso']) &&
             data.cif is string &&
             data.cif == cif &&
             validStringLength('nombre', 2, 40) &&
             validStringLength('sal', 8, 64) &&
             validStringLength('hash', 20, 160) &&
             validStringLength('telefono', 3, 40) &&
             validStringLength('lugar', 1, 60) &&
             data.admin is bool &&
             data.creado is number &&
             isValidOptionalNumber('ultimoAcceso');
    }

    function isValidMensaje(data) {
      return hasRequiredFields(['de', 'deNombre', 'para', 'texto', 'hora', 'ts', 'estado']) &&
             hasOnlyAllowedFields(['de', 'deNombre', 'para', 'texto', 'hora', 'ts', 'estado']) &&
             validStringLength('de', 2, 15) &&
             validStringLength('deNombre', 1, 40) &&
             validStringLength('para', 2, 15) &&
             validStringLength('texto', 1, 500) &&
             validStringLength('hora', 1, 20) &&
             data.ts is number &&
             data.estado is string &&
             data.estado in ['entregado', 'en cola'];
    }

    function isValidAlertaPublica(data) {
      return !data.keys().hasAny(['activa', 'tipo', 'titulo', 'mensaje', 'ts']) ||
             (data.keys().hasAll(['activa', 'tipo', 'titulo', 'mensaje', 'ts', 'emergencia']) &&
              data.activa is bool &&
              data.ts == data.actualizado &&
              validStringLength('tipo', 0, 30) &&
              validStringLength('titulo', 0, 120) &&
              validStringLength('mensaje', 0, 240) &&
              ((data.activa && data.emergencia is map &&
                data.tipo == data.emergencia.tipo &&
                data.titulo == data.emergencia.titulo &&
                data.mensaje == data.emergencia.texto) ||
               (!data.activa && data.emergencia == null &&
                data.tipo == '' && data.titulo == '' && data.mensaje == '')));
    }

    function isValidCampusEstado(data) {
      return hasRequiredFields(['bloqueados', 'congestion', 'actualizado']) &&
             hasOnlyAllowedFields(['bloqueados', 'congestion', 'actualizado', 'emergencia', 'activa', 'tipo', 'titulo', 'mensaje', 'ts']) &&
             isValidList(data.bloqueados, 100) &&
             isValidMap(data.congestion, 100) &&
             data.actualizado is number &&
             isValidEmergencia(data) &&
             isValidAlertaPublica(data);
    }

    function isValidReporteBloqueo(data) {
      return hasRequiredFields(['origen', 'destino', 'autor', 'ts']) &&
             hasOnlyAllowedFields(['origen', 'destino', 'autor', 'ts', 'estado']) &&
             validStringLength('origen', 1, 60) &&
             validStringLength('destino', 1, 60) &&
             validStringLength('autor', 2, 15) &&
             data.ts is number &&
             isValidOptionalString('estado', 1, 30);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /usuarios/{cif} {
      allow read: if isSelfUser(cif) || isAdminAuth();

      allow create: if (isSelfUser(cif) || isAdminAuth()) &&
                       isValidCifId(cif) &&
                       !exists(/databases/$(database)/documents/usuarios/$(cif)) &&
                       isValidUsuario(request.resource.data, cif) &&
                       request.resource.data.admin == false &&
                       !('ultimoAcceso' in request.resource.data);

      allow update: if (isSelfUser(cif) || isAdminAuth()) &&
                       isValidCifId(cif) &&
                       isValidUsuario(request.resource.data, cif) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lugar', 'ultimoAcceso']) &&
                       areImmutableFieldsUnchanged(['cif', 'nombre', 'sal', 'hash', 'telefono', 'admin', 'creado']);

      allow delete: if false;
    }

    match /mensajes/{msgId} {
      allow read: if isAuthenticated() &&
                     (resource.data.para == 'TODOS' ||
                      isSelfUser(resource.data.de) ||
                      isSelfUser(resource.data.para) ||
                      isAdminAuth());

      allow create: if isAuthenticated() &&
                       isValidMensaje(request.resource.data) &&
                       (isSelfUser(request.resource.data.de) || isAdminAuth());

      allow update: if isAuthenticated() &&
                       (isSelfUser(resource.data.de) ||
                        isSelfUser(resource.data.para) ||
                        isAdminAuth()) &&
                       isValidMensaje(request.resource.data) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
                       areImmutableFieldsUnchanged(['de', 'deNombre', 'para', 'texto', 'hora', 'ts']) &&
                       resource.data.estado == 'en cola' &&
                       request.resource.data.estado == 'entregado';

      allow delete: if false;
    }

    match /campus/{docId} {
      allow read: if docId == 'estado';

      allow create, update: if docId == 'estado' &&
                               isAdminAuth() &&
                               isValidCampusEstado(request.resource.data);

      allow delete: if false;
    }

    match /admins/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;

      allow write: if false;
    }

    match /reportes_bloqueo/{repId} {
      allow read: if isAdminAuth() || isSelfUser(resource.data.autor);

      allow create: if isAuthenticated() &&
                       isValidReporteBloqueo(request.resource.data) &&
                       (isSelfUser(request.resource.data.autor) || isAdminAuth()) &&
                       (!('estado' in request.resource.data) ||
                        request.resource.data.estado == 'pendiente' ||
                        isAdminAuth());

      allow update: if isAdminAuth() &&
                       isValidReporteBloqueo(request.resource.data) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
                       areImmutableFieldsUnchanged(['origen', 'destino', 'autor', 'ts']) &&
                       validStringLength('estado', 1, 30);

      allow delete: if false;
    }

    // CIFs ya registrados en el servidor web: solo los usa la Cloud Function (Admin SDK)
    match /cuentas_web/{cif} {
      allow read, write: if false;
    }

    // ===============================================================
    // Default Deny
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
