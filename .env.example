# Servidor Flask (opcionales)
UNEXUAM_SECRET_KEY=
UNEXUAM_DATOS=
UNEXUAM_TLS_CERT=
UNEXUAM_TLS_KEY=
UNEXUAM_SECURE_COOKIES=0

# Firebase (necesario para Cloud Firestore y FCM Push en Android)
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_PROJECT_NUMBER=000000000000
FIREBASE_STORAGE_BUCKET=tu-proyecto-firebase.firebasestorage.app
FIREBASE_ANDROID_APP_ID=1:000000000000:android:xxxxxxxxxxxxxxxxxxxxxx
FIREBASE_ANDROID_API_KEY=TU_FIREBASE_ANDROID_API_KEY
FIREBASE_ANDROID_PACKAGE=ni.edu.uam.unexuam
# Servidor web: ruta al JSON de Service Account con permisos de Firestore y FCM
FIREBASE_SERVICE_ACCOUNT_FILE=

# Pon 1 si Cloud Functions, en vez de Flask, envía FCM al escribir campus/estado.
FIREBASE_FUNCTIONS_PUSH=0
# Administrador inicial (opcional). Nunca pongas credenciales reales en el código.
# Se crea solo si la cuenta no existe o aún no es admin; no se reescribe en cada arranque.
UNEXUAM_ADMIN_CIF=
UNEXUAM_ADMIN_NOMBRE=
UNEXUAM_ADMIN_CLAVE=
